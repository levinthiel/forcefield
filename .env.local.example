# Copy to .env.local and fill in your Sanity project values.
# Create a project at https://www.sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Editor token (Sanity manage -> API -> Tokens) for npm run migrate:sanity
SANITY_API_WRITE_TOKEN=

# Random secret shared with the Sanity publish webhook -> POST /api/revalidate
SANITY_REVALIDATE_SECRET=

# Setup steps:
# 1. Copy this file to .env.local and set NEXT_PUBLIC_SANITY_PROJECT_ID
# 2. Run: npm run migrate:sanity
# 3. Run: npm run dev and open http://localhost:3000/studio
# 4. After deploy, add a Sanity webhook:
#    URL: https://your-domain/api/revalidate
#    Header: x-sanity-webhook-secret: <SANITY_REVALIDATE_SECRET>
#    Trigger: Create, Update, Delete
